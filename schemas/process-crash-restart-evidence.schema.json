{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcloak.network/schemas/process-crash-restart-evidence.schema.json",
  "title": "Accounting Case process kill and restart evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "captured_at", "release_version", "runtime_attestation_hash", "source_fingerprint", "generator", "raw_artifacts", "scenarios"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "const": "PASS" },
    "captured_at": { "type": "string", "format": "date-time" },
    "release_version": { "const": "0.4.0-rc.1" },
    "runtime_attestation_hash": { "$ref": "#/$defs/sha256" },
    "source_fingerprint": { "$ref": "#/$defs/sha256" },
    "generator": { "$ref": "#/$defs/generator" },
    "raw_artifacts": { "$ref": "#/$defs/rawArtifacts" },
    "scenarios": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "status", "termination", "termination_signal", "command", "server_pid_before", "server_pid_after", "restart_observed", "provider_write_count_after_restart", "recovery_outcome", "evidence_refs"],
        "properties": {
          "scenario_id": { "enum": ["AFTER_PREFLIGHT_PREPARED", "AFTER_WRITE_CLAIM_BEFORE_PROVIDER", "AFTER_PROVIDER_ACCEPT_BEFORE_DURABLE_COMPLETION", "AFTER_DURABLE_COMPLETION_BEFORE_RESPONSE"] },
          "status": { "const": "PASS" },
          "termination": { "const": "PROCESS_KILL" },
          "termination_signal": { "const": "SIGKILL" },
          "command": { "$ref": "#/$defs/nonEmptyString" },
          "server_pid_before": { "type": "integer", "minimum": 1 },
          "server_pid_after": { "type": "integer", "minimum": 1 },
          "restart_observed": { "const": true },
          "provider_write_count_after_restart": { "type": "integer", "minimum": 0, "maximum": 1 },
          "recovery_outcome": { "enum": ["RECOVERED_READBACK_VERIFIED", "BLOCKED_SAFE_UNKNOWN", "IDEMPOTENT_REPLAY"] },
          "evidence_refs": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonEmptyUniqueStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "version", "executable_path", "executable_sha256"],
      "properties": {
        "kind": { "const": "PROCESS_CRASH_RESTART_HARNESS" },
        "command": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "executable_path": { "$ref": "#/$defs/nonEmptyString" },
        "executable_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rawArtifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "scenario_id", "path", "sha256", "size_bytes"],
        "properties": {
          "artifact_type": { "const": "CRASH_SCENARIO_JSONL" },
          "scenario_id": {
            "enum": [
              "AFTER_PREFLIGHT_PREPARED",
              "AFTER_WRITE_CLAIM_BEFORE_PROVIDER",
              "AFTER_PROVIDER_ACCEPT_BEFORE_DURABLE_COMPLETION",
              "AFTER_DURABLE_COMPLETION_BEFORE_RESPONSE"
            ]
          },
          "path": { "$ref": "#/$defs/nonEmptyString" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
