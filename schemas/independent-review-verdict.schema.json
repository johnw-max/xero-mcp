{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcloak.network/schemas/independent-review-verdict.schema.json",
  "title": "Independent read-only Codex review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "implementation_execution_id",
    "source_fingerprint",
    "review_subject_sha256",
    "review_inputs_sha256",
    "overall_decision",
    "requirements"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "implementation_execution_id": { "$ref": "#/$defs/nonEmptyString" },
    "source_fingerprint": { "$ref": "#/$defs/sha256" },
    "review_subject_sha256": { "$ref": "#/$defs/sha256" },
    "review_inputs_sha256": { "$ref": "#/$defs/sha256" },
    "overall_decision": { "enum": ["CLOSED", "REOPEN"] },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirementVerdict" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fileReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "adversarialReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_path", "sha256"],
      "properties": {
        "test_path": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "falsificationProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_nonce",
        "counterexample",
        "target_path",
        "test_path",
        "literal",
        "replacement"
      ],
      "properties": {
        "probe_nonce": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "counterexample": {
          "type": "string",
          "minLength": 40,
          "maxLength": 1000,
          "pattern": "^[^'\\r\\n\\u0000]+$"
        },
        "target_path": { "$ref": "#/$defs/nonEmptyString" },
        "test_path": {
          "type": "string",
          "pattern": "^(tests|src)/.+\\.test\\.ts$"
        },
        "literal": {
          "type": "string",
          "minLength": 4,
          "maxLength": 256,
          "pattern": "^[^'\\r\\n\\u0000]+$"
        },
        "replacement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^'\\r\\n\\u0000]+$"
        }
      }
    },
    "requirementVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "reviewer_role",
        "decision",
        "evidence_checked",
        "adversarial_checks",
        "falsification_probe",
        "rationale",
        "residual_risk"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$"
        },
        "reviewer_role": { "$ref": "#/$defs/nonEmptyString" },
        "decision": { "enum": ["CLOSED", "REOPEN"] },
        "evidence_checked": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fileReceipt" }
        },
        "adversarial_checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/adversarialReceipt" }
        },
        "falsification_probe": { "$ref": "#/$defs/falsificationProbe" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" },
        "residual_risk": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
