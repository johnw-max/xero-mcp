NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=postgres://accounting_mcp:change-me@127.0.0.1:5432/accounting_mcp
MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters
MCP_ALLOWED_ORIGINS=http://127.0.0.1:3000
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
REQUEST_BODY_LIMIT_BYTES=1048576
XERO_CLIENT_ID=replace-from-xero-developer-console
XERO_CLIENT_SECRET=replace-from-xero-developer-console
XERO_SCOPES=openid profile email offline_access accounting.settings.read accounting.settings accounting.contacts.read accounting.contacts accounting.invoices.read accounting.invoices accounting.payments.read accounting.manualjournals.read accounting.manualjournals accounting.banktransactions.read accounting.reports.trialbalance.read
TOKEN_ENCRYPTION_KEY_B64=replace-with-base64-encoded-32-byte-key
XERO_MUTATION_CONFIRMATION_KEY_B64=replace-with-a-different-base64-encoded-32-byte-key
# Strict mode makes every ledger call pin one short-lived organisation target.
# Keep false only while upgrading an older Host/Agent prompt to the 0.4 contract.
XERO_TARGET_SESSION_REQUIRED=true
XERO_TARGET_SESSION_TTL_SECONDS=1800
# Exact comma-separated Xero tenant IDs allowed to receive facts marked testDocument=true.
XERO_ACCOUNTING_CASE_TEST_TENANT_IDS=
XERO_TENANT_COA_PROFILES_JSON=[]
# Test-only: production rejects candidate-supplied authority JSON, including
# legacy boolean/hash assertions. Runtime Ed25519 fixtures belong in tests.
XERO_ACCOUNTING_CASE_BUSINESS_AUTHORITIES_JSON=[]
# Production deployments pin externally signed public governance files by
# hash. Their paths are fixed by the admission/Compose contract, never config.
# XERO_GOVERNANCE_TRUST_BUNDLE_SHA256=replace-with-64-lowercase-hex
# XERO_GOVERNANCE_RECEIPTS_SHA256=replace-with-64-lowercase-hex
# XERO_GOVERNANCE_STATUS_SHA256=replace-with-64-lowercase-hex
# Standing autonomous write is independently granted to an exact Work/Agent,
# OAuth installation, Xero tenant and action set. No wildcard is accepted.
XERO_WRITE_ENABLED=false
XERO_AUTHORITY_REVISION=1
XERO_STANDING_DELEGATIONS_JSON=[]
# Required for writes: SHA-256 of the exact JSON value bytes above.
# XERO_STANDING_DELEGATIONS_CONFIG_SHA256=replace-with-64-lowercase-hex

# Host-independent MCP OAuth Broker. It is off by default, so existing deployments
# do not need any of the Broker secrets below until this is explicitly enabled.
MCP_OAUTH_BROKER_ENABLED=false
PERSONAL_POC_ONLY=false
SHARED_TEST_USERS=false
# Multiple pre-registered Host clients can coexist. Each client must use its own
# secret and exact callback; never share one Personal POC client across users.
# HOST_OAUTH_CLIENTS_JSON=[{"name":"Agent2","client_id":"replace-agent2-client-id","client_secret":"replace-with-at-least-32-random-characters","redirect_uris":["https://agent2.zcloak.ai/api/mcp/accounting-mcp/oauth/callback"]},{"name":"Work","client_id":"replace-work-client-id","client_secret":"replace-with-a-different-secret","redirect_uris":["https://work.zcloak.ai/api/mcp/replace-server-identifier/oauth/callback"]}]
# OAUTH_MISSING_RESOURCE_COMPAT_CLIENT_IDS=replace-agent2-client-id
# Independent allowlist for Personal POC/UAT Hosts that require a user-clicked
# return page because their browser/client blocks the automatic cross-site 302.
# This is independent from missing-resource compatibility and keeps the exact
# registered callback, state, PKCE and one-time authorization code unchanged.
# OAUTH_MANUAL_RETURN_CLIENT_IDS=replace-agent2-client-id,replace-work-client-id
# OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
# OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# OAUTH_AUTH_CODE_TTL_SECONDS=300
# OAUTH_BROWSER_FLOW_TTL_SECONDS=600
# OAUTH_TOKEN_HASH_KEY_B64=replace-with-a-distinct-base64-encoded-32-byte-key
# OAUTH_COOKIE_STATE_KEY_B64=replace-with-another-distinct-base64-encoded-32-byte-key

DEMO_ACTOR_ID=demo-operator
LOG_LEVEL=info
