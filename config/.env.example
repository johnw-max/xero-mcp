NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=postgres://accounting_mcp:change-me@127.0.0.1:5432/accounting_mcp
MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters
MCP_ALLOWED_ORIGINS=http://127.0.0.1:3000
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
REQUEST_BODY_LIMIT_BYTES=1048576
XERO_CLIENT_ID=replace-from-xero-developer-console
XERO_CLIENT_SECRET=replace-from-xero-developer-console
XERO_SCOPES=openid profile email offline_access accounting.settings.read accounting.settings accounting.contacts.read accounting.contacts accounting.invoices.read accounting.invoices accounting.payments.read accounting.manualjournals.read accounting.manualjournals accounting.banktransactions.read accounting.reports.trialbalance.read
TOKEN_ENCRYPTION_KEY_B64=replace-with-base64-encoded-32-byte-key
XERO_MUTATION_CONFIRMATION_KEY_B64=replace-with-a-different-base64-encoded-32-byte-key

# Host-independent MCP OAuth Broker. It is off by default, so existing deployments
# do not need any of the Broker secrets below until this is explicitly enabled.
MCP_OAUTH_BROKER_ENABLED=false
PERSONAL_POC_ONLY=false
# HOST_OAUTH_CLIENTS_JSON=[{"name":"Agent2","client_id":"replace-agent2-client-id","client_secret":"replace-with-at-least-32-random-characters","redirect_uris":["https://agent2.zcloak.ai/api/mcp/accounting-mcp/oauth/callback"]}]
# OAUTH_MISSING_RESOURCE_COMPAT_CLIENT_IDS=replace-agent2-client-id
# OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
# OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# OAUTH_AUTH_CODE_TTL_SECONDS=300
# OAUTH_BROWSER_FLOW_TTL_SECONDS=600
# OAUTH_TOKEN_HASH_KEY_B64=replace-with-a-distinct-base64-encoded-32-byte-key
# OAUTH_COOKIE_STATE_KEY_B64=replace-with-another-distinct-base64-encoded-32-byte-key

DEMO_ACTOR_ID=demo-operator
LOG_LEVEL=info
