{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcloak.example/schemas/xero-mcp-oracle-result-v1.json",
  "title": "Xero MCP exhaustive test result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "suite_id",
    "layer",
    "started_at",
    "finished_at",
    "environment",
    "case_results",
    "summary",
    "claim_guardrail_violations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 8 },
    "suite_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "layer": {
      "enum": [
        "DETERMINISTIC_CONTRACT",
        "AGENT2_BEHAVIOR",
        "FINAL_BROWSER_SIGNATURE"
      ]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "data_class", "write_gate_start", "write_gate_end", "secrets_redacted"],
      "properties": {
        "target": { "enum": ["IN_MEMORY", "LOCAL_HTTP", "REMOTE_MCP", "AGENT2_API", "AGENT2_BROWSER"] },
        "data_class": { "const": "SYNTHETIC_ONLY" },
        "write_gate_start": { "enum": ["CLOSED", "OPEN"] },
        "write_gate_end": { "enum": ["CLOSED", "OPEN"] },
        "secrets_redacted": { "const": true },
        "mcp_server_version": { "type": "string" },
        "agent_ids": { "type": "array", "items": { "type": "string" } },
        "oauth_binding_fingerprint": { "type": "string" }
      }
    },
    "case_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/caseResult" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "pass",
        "fail",
        "blocked_model_provider",
        "blocked_env",
        "blocked_test_data",
        "unsupported",
        "flaky",
        "not_run"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "blocked_model_provider": { "type": "integer", "minimum": 0 },
        "blocked_env": { "type": "integer", "minimum": 0 },
        "blocked_test_data": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "flaky": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 }
      }
    },
    "claim_guardrail_violations": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CG-[0-9]{3}$" }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_MODEL_PROVIDER",
        "BLOCKED_ENV",
        "BLOCKED_TEST_DATA",
        "UNSUPPORTED",
        "FLAKY",
        "NOT_RUN"
      ]
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "persona_id",
        "baseline_expectation",
        "actual_status",
        "hard_gate_passed",
        "expected_red_observed",
        "oracle_results",
        "evidence_refs"
      ],
      "properties": {
        "case_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{4,63}$" },
        "persona_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
        "repeat_index": { "type": "integer", "minimum": 1 },
        "baseline_expectation": { "enum": ["PASS", "EXPECTED_RED"] },
        "actual_status": { "$ref": "#/$defs/status" },
        "hard_gate_passed": { "type": "boolean" },
        "expected_red_observed": { "type": "boolean" },
        "oracle_results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/oracleResult" }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "blocker_detail": { "type": "string" },
        "write_receipt": { "$ref": "#/$defs/writeReceipt" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "actual_status": { "const": "PASS" } }, "required": ["actual_status"] },
          "then": {
            "properties": {
              "hard_gate_passed": { "const": true },
              "expected_red_observed": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": { "expected_red_observed": { "const": true } },
            "required": ["expected_red_observed"]
          },
          "then": { "properties": { "actual_status": { "const": "FAIL" } } }
        },
        {
          "if": {
            "properties": { "actual_status": { "enum": ["BLOCKED_MODEL_PROVIDER", "BLOCKED_ENV", "BLOCKED_TEST_DATA"] } },
            "required": ["actual_status"]
          },
          "then": { "required": ["blocker_detail"] }
        }
      ]
    },
    "oracleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle_id", "strength", "status", "observed", "evidence_refs"],
      "properties": {
        "oracle_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]+$" },
        "strength": { "enum": ["HARD", "SEMANTIC", "MANUAL"] },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
        "observed": true,
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "message": { "type": "string" }
      }
    },
    "writeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "provider_record_id",
        "provider_status",
        "provider_write_count",
        "exact_readback_id",
        "idempotent_replay"
      ],
      "properties": {
        "request_id": { "type": "string", "minLength": 8 },
        "provider_record_id": { "type": "string", "format": "uuid" },
        "provider_status": { "const": "DRAFT" },
        "provider_write_count": { "const": 1 },
        "exact_readback_id": { "type": "string", "format": "uuid" },
        "idempotent_replay": { "type": "boolean" },
        "posting_request_id": { "type": "string" },
        "payload_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
