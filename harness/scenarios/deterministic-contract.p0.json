{
  "schema_version": "1.0",
  "suite_id": "xero-deterministic-contract-p0",
  "layer": "DETERMINISTIC_CONTRACT",
  "description": "Model-independent MCP, provider-fixture, repository, idempotency, pagination, and recovery contracts. These hard oracles define whether the MCP itself is correct.",
  "safety": {
    "data_class": "SYNTHETIC_ONLY",
    "write_policy": "ONE_CONTROLLED_DRAFT_WRITER",
    "authorise_forbidden": true,
    "payment_forbidden": true,
    "write_gate_must_start_closed": true,
    "write_gate_must_end_closed": true
  },
  "defaults": {
    "repeats": 1,
    "remote_concurrency": 1,
    "tenant_calls_per_minute": 45,
    "read_retry_limit": 2,
    "write_retry_limit": 0
  },
  "cases": [
    {
      "id": "DC-CONNECTION-001",
      "title": "Exact tool surface, connection, scope, and bound organisation",
      "priority": "P0",
      "mode": "READ_ONLY",
      "personas": ["protocol_security_agent"],
      "fixture_refs": ["harness/fixtures/xero/synthetic-ledger.json#/organisation"],
      "prerequisites": ["Fresh in-memory MCP server", "Read scope granted", "Write gate closed"],
      "steps": [
        {
          "id": "list_tools",
          "actor": "deterministic_harness",
          "action": "STATE_PROBE",
          "capture": ["TOOL_OUTPUT"],
          "oracles": [
            {
              "id": "exact_27_tools",
              "strength": "HARD",
              "kind": "EXACT_TOOL_SET",
              "source": "TOOL_OUTPUT",
              "operator": "SET_EQ",
              "expected": [
                "xero_connection_status",
                "xero_get_organisation",
                "xero_list_accounts",
                "xero_list_tax_rates",
                "xero_list_contacts",
                "xero_get_contact",
                "xero_search_contacts",
                "xero_list_invoices",
                "xero_list_credit_notes",
                "xero_list_payments",
                "xero_list_quotes",
                "xero_get_quote",
                "xero_list_purchase_orders",
                "xero_get_purchase_order",
                "xero_list_manual_journals",
                "xero_get_manual_journal",
                "xero_list_items",
                "xero_get_item",
                "xero_list_bank_transactions",
                "xero_get_bank_transaction",
                "xero_get_invoice",
                "xero_get_supplier_bill",
                "xero_prepare_supplier_bill_draft",
                "xero_create_draft_supplier_bill",
                "xero_prepare_sales_invoice_draft",
                "xero_create_draft_sales_invoice",
                "xero_get_trial_balance"
              ],
              "evidence_required": ["tools/list response"],
              "on_failure": "FAIL_CASE"
            }
          ]
        },
        {
          "id": "connection_status",
          "actor": "deterministic_harness",
          "action": "MCP_CALL",
          "tool": "xero_connection_status",
          "input": {},
          "capture": ["TOOL_CALL", "TOOL_OUTPUT"],
          "oracles": [
            {
              "id": "connected_true",
              "strength": "HARD",
              "kind": "JSON_PATH",
              "source": "TOOL_OUTPUT",
              "path": "$.result.connected",
              "operator": "EQ",
              "expected": true,
              "evidence_required": ["structured tool output"],
              "on_failure": "FAIL_CASE"
            },
            {
              "id": "write_scope_absent",
              "strength": "HARD",
              "kind": "JSON_PATH",
              "source": "TOOL_OUTPUT",
              "path": "$.result.scopes",
              "operator": "NOT_CONTAINS",
              "expected": "xero.draft.write",
              "evidence_required": ["scope list"],
              "on_failure": "FAIL_CASE"
            }
          ]
        },
        {
          "id": "get_organisation",
          "actor": "deterministic_harness",
          "action": "MCP_CALL",
          "tool": "xero_get_organisation",
          "input": {},
          "capture": ["TOOL_CALL", "TOOL_OUTPUT", "PROVIDER_CALL"],
          "oracles": [
            {
              "id": "exact_org_id",
              "strength": "HARD",
              "kind": "JSON_PATH",
              "source": "TOOL_OUTPUT",
              "path": "$.bound_target_ref_safe",
              "operator": "EQ",
              "expected": "xero-target:dc9d3f00dd10d78457f4b82e437e258b",
