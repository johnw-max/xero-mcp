      "final_oracles": [
        {
          "id": "tb_not_claimed_complete_without_bound",
          "strength": "HARD",
          "kind": "EVIDENCE_PRESENT",
          "source": "AGGREGATE",
          "operator": "EXISTS",
          "expected": "independently measured content-only Trial Balance transport bounds, visited JSON-node bound, and explicit Provider-completeness evidence",
          "evidence_required": ["pressure response"],
          "on_failure": "FAIL_CASE"
        }
      ],
      "baseline_expectation": "EXPECTED_RED",
      "expected_red_ref": "XR-005",
      "tags": ["accounts", "tax", "trial_balance", "bounds"]
