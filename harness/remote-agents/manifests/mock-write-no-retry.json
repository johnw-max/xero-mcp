{
  "version": 1,
  "name": "offline-accounting-case-write-no-retry-regression",
  "releaseContract": "0.4.0-rc.1 / pinned OAuth target + released typed Case action + write gate / Case execute identity only",
  "settings": {
    "concurrency": 2,
    "timeoutMs": 5000,
    "readMaxAttempts": 3,
    "readRetryBaseMs": 0,
    "maxRetryAfterMs": 1000,
    "retryJitterRatio": 0
  },
  "agents": [
    {
      "alias": "controlled_writer",
      "id": "mock-writer-agent",
      "persona": "Controlled accounting operator who executes only a stored Accounting Case for the pinned OAuth target and released typed action while the write gate is active, and always requires Provider receipt plus exact readback."
    }
  ],
  "cases": [
    {
      "id": "write-503-must-not-retry",
      "title": "A failed write-intent request is not automatically retried",
      "operation": "write",
      "fixture": "../fixtures/synthetic-draft-candidate.txt",
      "agents": ["controlled_writer"],
      "transcript": [
        {
          "role": "developer",
          "content": "Synthetic draft candidate:\n\n{{fixture}}"
        },
        {
          "role": "user",
          "content": "{{fixture}}\n\nFor the pinned OAuth target and released typed Case action while the write gate is active, execute Accounting Case synthetic-case-001 version 1 once with request_id synthetic-case-request-001. Do not submit accounting payload at execute time. Stop after the first unknown result and recover by Case status/readback only."
        }
      ],
      "expect": {
        "requiredTools": ["*xero_execute_accounting_case"],
        "minToolCalls": 1,
        "maxToolCalls": 1,
        "allCallsHaveOutput": true
      },
      "mock": {
        "sequence": [
          {
            "status": 503,
            "headers": {
              "Retry-After": "0"
            },
            "body": {
              "error": "synthetic response loss"
            }
          },
          {
            "status": 200,
            "body": {
              "id": "resp_should_never_be_reached",
              "status": "completed",
              "output": [
                {
                  "type": "function_call",
                  "call_id": "call_should_never_be_reached",
                  "name": "accounting__xero_execute_accounting_case",
                  "arguments": "{\"case_id\":\"synthetic-case-001\",\"case_version\":1,\"request_id\":\"synthetic-case-request-001\"}",
                  "status": "completed"
                },
                {
                  "type": "function_call_output",
                  "call_id": "call_should_never_be_reached",
                  "output": "{\"status\":\"DRAFT\"}",
                  "status": "completed"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
