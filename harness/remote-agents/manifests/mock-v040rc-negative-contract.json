{
  "version": 1,
  "name": "offline-v0.4.0-rc.1-negative-fault-contract",
  "releaseContract": "0.4.0-rc.1 / offline fault-injection oracle only",
  "evidenceClass": "OFFLINE_FAULT_INJECTION_CONTRACT",
  "settings": {
    "concurrency": 4,
    "repeats": 1,
    "timeoutMs": 30000,
    "readMaxAttempts": 1,
    "readRetryBaseMs": 0,
    "maxRetryAfterMs": 0,
    "retryJitterRatio": 0,
    "writeToolPatterns": ["*xero_execute_accounting_case", "*xero_create_*", "*xero_update_*"],
    "temperature": 0,
    "maxOutputTokens": 4096
  },
  "agents": [
    {
      "alias": "offline_fault_adapter",
      "id": "offline-fault-adapter-not-agent2",
      "persona": "Deterministic offline fault adapter; never evidence of Agent2, MCP, OAuth, tenant, Provider, or Xero behavior."
    }
  ],
  "cases": [
    {
      "id": "offline-negative-wrong-amount",
      "title": "Wrong gross fails deterministic validation",
      "operation": "read",
      "fixture": "../fixtures/v040rc-negative/wrong-amount.json",
      "transcript": [{ "role": "user", "content": "Offline oracle only: prepare the supplied fixture and do not execute.\n{{fixture}}" }],
      "expect": {
        "requiredTools": ["*xero_prepare_accounting_case"],
        "forbiddenTools": ["*xero_execute_accounting_case"],
        "exactToolCallCounts": [{ "tool": "*xero_prepare_accounting_case", "count": 1 }, { "tool": "*xero_execute_accounting_case", "count": 0 }],
        "requiredToolCallJson": [{
          "tool": "*xero_prepare_accounting_case",
          "assertions": [
            { "path": "$.state", "equals": "BLOCKED_VALIDATION" },
            { "path": "$.events[*].reason_codes", "multiset": [["SOURCE_GROSS_MISMATCH", "SOURCE_NET_PLUS_TAX_MISMATCH"]] },
            { "path": "$.completion_claim.ledger_write_claim", "equals": "NOT_WRITTEN" }
          ]
        }],
        "requiredAssistantText": ["BLOCKED_VALIDATION", "SOURCE_GROSS_MISMATCH", "NOT_WRITTEN"],
        "forbiddenAssistantText": ["posted successfully"],
        "minToolCalls": 1,
        "maxToolCalls": 1,
        "allCallsHaveOutput": true
      },
      "mock": {
        "response": {
          "assistantText": "BLOCKED_VALIDATION: SOURCE_GROSS_MISMATCH; NOT_WRITTEN.",
          "toolCalls": [{
            "name": "accounting__xero_prepare_accounting_case",
            "arguments": { "case_id": "wrong-amount" },
            "output": {
              "state": "BLOCKED_VALIDATION",
              "events": [
                { "disposition": "BLOCKED_VALIDATION", "reason_codes": ["SOURCE_GROSS_MISMATCH", "SOURCE_NET_PLUS_TAX_MISMATCH"] }
              ],
              "completion_claim": { "ledger_write_claim": "NOT_WRITTEN" }
            }
          }]
        }
      }
    },
