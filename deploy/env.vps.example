# Copy to deploy/.env.vps on the VPS and set mode 0600. Never commit the real file.
COMPOSE_PROJECT_NAME=xero-accounting-mcp-demo

# Immutable image digests are preferred after the first verified pull.
APP_IMAGE=xero-accounting-mcp-demo:0.3.0-xero-pilot-20260808.4
# Keep QuickBooks on its independently verified image; do not implicitly
# downgrade it when the Xero image changes.
QUICKBOOKS_APP_IMAGE=xero-accounting-mcp-demo:0.2.12-quickbooks-20260806
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29.4-alpine
POSTGRES_IMAGE=postgres:17.10-alpine3.23

# Public edge and TLS paths.
MCP_PUBLIC_HOST=mcp.jiayuanwang.xyz
PUBLIC_BASE_URL=https://mcp.jiayuanwang.xyz
APP_LOOPBACK_PORT=18002
GREEN_APP_LOOPBACK_PORT=18004
QUICKBOOKS_LOOPBACK_PORT=18003
# The 0.3.0 green slot joins the already-running main stack without owning or
# recreating its PostgreSQL/QuickBooks services.
EXISTING_EGRESS_NETWORK=xero-accounting-mcp-demo_egress
EXISTING_DATA_NETWORK=xero-accounting-mcp-demo_data
# The next two paths are consumed only by the alternative container-Nginx
# Compose file. Current host-Nginx deployment terminates TLS on the host.
TLS_CERT_DIR=/srv/xero-accounting-mcp/tls
CERTBOT_WEBROOT_DIR=/srv/xero-accounting-mcp/certbot

# PostgreSQL is only reachable on the internal Docker network. URL-encode the
# password inside DATABASE_URL if it contains reserved URI characters.
POSTGRES_DATA_DIR=/srv/xero-accounting-mcp/postgres
POSTGRES_DB=xero_mcp
POSTGRES_USER=xero_mcp
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://xero_mcp:REPLACE_WITH_THE_SAME_URL_ENCODED_PASSWORD@postgres:5432/xero_mcp?sslmode=disable

# Legacy Agent -> MCP authentication. It remains required only so an OAuth-off
# rollback can start; when MCP_OAUTH_BROKER_ENABLED=true, /mcp accepts OAuth
# access tokens instead of this shared credential.
MCP_BEARER_TOKEN=REPLACE_WITH_A_32_BYTE_OR_LONGER_RANDOM_TOKEN
MCP_ALLOWED_HOSTS=mcp.jiayuanwang.xyz
MCP_ALLOWED_ORIGINS=https://agent2.zcloak.ai,https://mcp.jiayuanwang.xyz
REQUEST_BODY_LIMIT_BYTES=1048576

# Host-neutral MCP OAuth Broker. Agent2 is the first UAT Host and its callback
# must match exactly; never put these secrets in screenshots, chat, or git.
MCP_OAUTH_BROKER_ENABLED=true
PERSONAL_POC_ONLY=true
HOST_OAUTH_CLIENTS_JSON=[{"name":"Agent2","client_id":"REPLACE_WITH_AGENT2_OAUTH_CLIENT_ID","client_secret":"REPLACE_WITH_32_RANDOM_BYTES_OR_MORE","redirect_uris":["https://agent2.zcloak.ai/api/mcp/accounting-mcp/oauth/callback"]}]
# Exact public client-ID allowlist for legacy Hosts that omit RFC 8707 resource.
# Leave empty unless compatibility is required; values must already exist above.
OAUTH_MISSING_RESOURCE_COMPAT_CLIENT_IDS=REPLACE_WITH_AGENT2_OAUTH_CLIENT_ID
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_AUTH_CODE_TTL_SECONDS=300
OAUTH_BROWSER_FLOW_TTL_SECONDS=600
# Both keys are independent 32-byte base64 values and must also differ from
# TOKEN_ENCRYPTION_KEY_B64.
OAUTH_TOKEN_HASH_KEY_B64=REPLACE_WITH_DISTINCT_32_BYTE_BASE64_KEY
OAUTH_COOKIE_STATE_KEY_B64=REPLACE_WITH_ANOTHER_DISTINCT_32_BYTE_BASE64_KEY

# Xero developer app. Register this exact callback:
# https://mcp.jiayuanwang.xyz/oauth/xero/callback
XERO_CLIENT_ID=REPLACE_WITH_XERO_CLIENT_ID
XERO_CLIENT_SECRET=REPLACE_WITH_XERO_CLIENT_SECRET
XERO_SCOPES=openid profile email offline_access accounting.settings.read accounting.settings accounting.contacts.read accounting.contacts accounting.invoices.read accounting.invoices accounting.payments.read accounting.manualjournals.read accounting.manualjournals accounting.banktransactions.read accounting.reports.trialbalance.read
# Keep writes disabled through OAuth/read-only verification. For Broker OAuth,
# enabling the flag still permits DRAFT only and the selected server-side
# binding replaces the legacy global tenant allowlist.
XERO_WRITE_ENABLED=false
XERO_ALLOWED_TENANT_ID=

# 32 raw random bytes encoded as base64, for example: openssl rand -base64 32
# This key must stay paired with the encrypted token rows and backups.
TOKEN_ENCRYPTION_KEY_B64=REPLACE_WITH_32_BYTE_BASE64_KEY
XERO_MUTATION_CONFIRMATION_KEY_B64=REPLACE_WITH_A_DIFFERENT_32_BYTE_BASE64_KEY

DEMO_ACTOR_ID=xero-demo-operator
LOG_LEVEL=info

# QuickBooks Online Agent2 test service. The Intuit Development app must
# register this exact callback:
# https://mcp.jiayuanwang.xyz/oauth/quickbooks/callback
QUICKBOOKS_PUBLIC_BASE_URL=https://mcp.jiayuanwang.xyz
QUICKBOOKS_MCP_BEARER_TOKEN=REPLACE_WITH_AN_INDEPENDENT_32_BYTE_OR_LONGER_RANDOM_TOKEN
QUICKBOOKS_MCP_ALLOWED_HOSTS=mcp.jiayuanwang.xyz
QUICKBOOKS_MCP_ALLOWED_ORIGINS=https://agent2.zcloak.ai,https://mcp.jiayuanwang.xyz
QUICKBOOKS_REQUEST_BODY_LIMIT_BYTES=1048576
# Agent2 -> this MCP OAuth client. Each completed authorization creates a
# distinct server-side actor and binds it to the selected QuickBooks company.
QUICKBOOKS_MCP_OAUTH_ENABLED=true
QUICKBOOKS_MCP_OAUTH_CLIENT_ID=agent2-quickbooks-accounting-mcp
QUICKBOOKS_MCP_OAUTH_CLIENT_SECRET=REPLACE_WITH_AN_INDEPENDENT_32_BYTE_OR_LONGER_RANDOM_TOKEN
QUICKBOOKS_MCP_OAUTH_REDIRECT_URIS=https://agent2.zcloak.ai/api/mcp/quickbooks-accounting-mcp/oauth/callback
QUICKBOOKS_MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
QUICKBOOKS_MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
QUICKBOOKS_CLIENT_ID=REPLACE_WITH_INTUIT_DEVELOPMENT_CLIENT_ID
QUICKBOOKS_CLIENT_SECRET=REPLACE_WITH_INTUIT_DEVELOPMENT_CLIENT_SECRET
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_MINOR_VERSION=
# Keep writes disabled until OAuth, read-only history, and Review UAT pass.
QUICKBOOKS_WRITE_ENABLED=false
# Verified Intuit Sandbox Company ID; this becomes active only when writes are
# explicitly enabled.
QUICKBOOKS_ALLOWED_REALM_ID=9341457658718743
# Must be independent from every Xero and OAuth Broker key.
QUICKBOOKS_TOKEN_ENCRYPTION_KEY_B64=REPLACE_WITH_DISTINCT_32_BYTE_BASE64_KEY
QUICKBOOKS_DEMO_ACTOR_ID=quickbooks-agent2-test
QUICKBOOKS_LOG_LEVEL=info

# Standalone Compose enforces these service limits directly.
APP_MEMORY_LIMIT=768m
APP_CPU_LIMIT=1.0
QUICKBOOKS_MEMORY_LIMIT=768m
QUICKBOOKS_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_CPU_LIMIT=1.0
POSTGRES_SHM_SIZE=128m
NGINX_MEMORY_LIMIT=128m
NGINX_CPU_LIMIT=0.5
