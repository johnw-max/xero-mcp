# Copy to deploy/.env.vps on the VPS and set mode 0600. Never commit the real file.
COMPOSE_PROJECT_NAME=xero-accounting-mcp-demo

# An immutable repo@sha256 digest from the approved local Gate build is mandatory.
# Mutable tags and hand-built images are rejected by the green guard/cutover.
APP_IMAGE=REPLACE_WITH_REGISTRY_REPOSITORY@sha256:REPLACE_WITH_APPROVED_IMAGE_DIGEST
# Root-only, read-only copies of the exact PASS Gate artifacts used by the
# cutover verifier. The switch script rejects missing, stale, or hand-edited
# receipts and verifies the OCI archive bytes before changing Nginx.
XERO_ACCEPTANCE_GATE_RESULT=/srv/xero-accounting-mcp/release/gate-result.json
XERO_ACCEPTANCE_GATE_RECEIPT=/srv/xero-accounting-mcp/release/accepted-build-context-receipt.json
XERO_ACCEPTED_OCI_RECEIPT=/srv/xero-accounting-mcp/release/xero-accounting-mcp-0.4.0-rc.1.oci-receipt.json
XERO_ACCEPTED_OCI_ARTIFACT=/srv/xero-accounting-mcp/release/xero-accounting-mcp-0.4.0-rc.1.oci.tar
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29.4-alpine
POSTGRES_IMAGE=postgres:17.10-alpine3.23

# Public edge and TLS paths.
MCP_PUBLIC_HOST=mcp.jiayuanwang.xyz
PUBLIC_BASE_URL=https://mcp.jiayuanwang.xyz
APP_LOOPBACK_PORT=18002
GREEN_APP_LOOPBACK_PORT=18004
# The 0.4.0-rc.1 green slot joins the already-running main stack without owning or
# recreating PostgreSQL or other services.
EXISTING_EGRESS_NETWORK=xero-accounting-mcp-demo_egress
EXISTING_DATA_NETWORK=xero-accounting-mcp-demo_data
# The next two paths are consumed only by the alternative container-Nginx
# Compose file. Current host-Nginx deployment terminates TLS on the host.
TLS_CERT_DIR=/srv/xero-accounting-mcp/tls
CERTBOT_WEBROOT_DIR=/srv/xero-accounting-mcp/certbot

# PostgreSQL is only reachable on the internal Docker network. URL-encode the
# password inside DATABASE_URL if it contains reserved URI characters.
POSTGRES_DATA_DIR=/srv/xero-accounting-mcp/postgres
POSTGRES_DB=xero_mcp
POSTGRES_USER=xero_mcp
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://xero_mcp:REPLACE_WITH_THE_SAME_URL_ENCODED_PASSWORD@postgres:5432/xero_mcp?sslmode=disable

# Legacy Agent -> MCP authentication. It remains required only so an OAuth-off
# rollback can start; when MCP_OAUTH_BROKER_ENABLED=true, /mcp accepts OAuth
# access tokens instead of this shared credential.
MCP_BEARER_TOKEN=REPLACE_WITH_A_32_BYTE_OR_LONGER_RANDOM_TOKEN
MCP_ALLOWED_HOSTS=mcp.jiayuanwang.xyz
MCP_ALLOWED_ORIGINS=https://agent2.zcloak.ai,https://work.zcloak.ai,https://mcp.jiayuanwang.xyz
REQUEST_BODY_LIMIT_BYTES=1048576

# Host-neutral MCP OAuth Broker. Agent2 is the first UAT Host and its callback
# must match exactly; never put these secrets in screenshots, chat, or git.
MCP_OAUTH_BROKER_ENABLED=true
PERSONAL_POC_ONLY=true
# Early-UAT only: the registered Work client identifies the application, while
# every completed OAuth flow receives an independent installation/token/tenant
# binding. This allows multiple testers to share one Work Client ID/Secret
# without one tester replacing another tester's grant.
SHARED_TEST_USERS=true
HOST_OAUTH_CLIENTS_JSON=[{"name":"Agent2","client_id":"REPLACE_WITH_AGENT2_OAUTH_CLIENT_ID","client_secret":"REPLACE_WITH_32_RANDOM_BYTES_OR_MORE","redirect_uris":["https://agent2.zcloak.ai/api/mcp/accounting-mcp/oauth/callback"]},{"name":"Work","client_id":"REPLACE_WITH_WORK_OAUTH_CLIENT_ID","client_secret":"REPLACE_WITH_A_DIFFERENT_32_RANDOM_BYTES_OR_MORE","redirect_uris":["https://work.zcloak.ai/api/mcp/REPLACE_WITH_WORK_SERVER_IDENTIFIER/oauth/callback"]}]
# Exact public client-ID allowlist for legacy Hosts that omit RFC 8707 resource.
# Leave empty unless compatibility is required; values must already exist above.
OAUTH_MISSING_RESOURCE_COMPAT_CLIENT_IDS=REPLACE_WITH_AGENT2_OAUTH_CLIENT_ID,REPLACE_WITH_WORK_OAUTH_CLIENT_ID
# Browser handoff policy is independent from RFC 8707 compatibility. Current
# Personal POC/UAT Agent2 and Work clients use a user-clicked GET return form
# because their browser/client may block an automatic cross-site 302. The form
# still submits the exact registered callback, state and one-time code.
OAUTH_MANUAL_RETURN_CLIENT_IDS=REPLACE_WITH_AGENT2_OAUTH_CLIENT_ID,REPLACE_WITH_WORK_OAUTH_CLIENT_ID
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_AUTH_CODE_TTL_SECONDS=300
OAUTH_BROWSER_FLOW_TTL_SECONDS=600
# Both keys are independent 32-byte base64 values and must also differ from
# TOKEN_ENCRYPTION_KEY_B64.
OAUTH_TOKEN_HASH_KEY_B64=REPLACE_WITH_DISTINCT_32_BYTE_BASE64_KEY
OAUTH_COOKIE_STATE_KEY_B64=REPLACE_WITH_ANOTHER_DISTINCT_32_BYTE_BASE64_KEY

# Xero developer app. Register this exact callback:
# https://mcp.jiayuanwang.xyz/oauth/xero/callback
XERO_CLIENT_ID=REPLACE_WITH_XERO_CLIENT_ID
XERO_CLIENT_SECRET=REPLACE_WITH_XERO_CLIENT_SECRET
XERO_SCOPES=openid profile email offline_access accounting.settings.read accounting.settings accounting.contacts.read accounting.contacts accounting.invoices.read accounting.invoices accounting.payments.read accounting.payments accounting.manualjournals.read accounting.manualjournals accounting.banktransactions.read accounting.banktransactions accounting.reports.trialbalance.read accounting.reports.profitandloss.read accounting.reports.balancesheet.read accounting.reports.aged.read
# Keep writes disabled through OAuth/read-only verification. When enabled, the
# current selected organisation binding is the ledger target.
XERO_WRITE_ENABLED=false
XERO_ALLOWED_TENANT_ID=
# Exact comma-separated test-company tenant IDs for governed Accounting Cases.
XERO_ACCOUNTING_CASE_TEST_TENANT_IDS=
# Required for every active write tenant. Maps semantic categories to exact
# tenant-local Xero AccountID+code+type+class under a versioned server profile.
XERO_TENANT_COA_PROFILES_JSON=[]

# 32 raw random bytes encoded as base64, for example: openssl rand -base64 32
# This key must stay paired with the encrypted token rows and backups.
TOKEN_ENCRYPTION_KEY_B64=REPLACE_WITH_32_BYTE_BASE64_KEY
XERO_MUTATION_CONFIRMATION_KEY_B64=REPLACE_WITH_A_DIFFERENT_32_BYTE_BASE64_KEY
# 0.4 ledger isolation: pin each conversation to one immutable Organisation for 30 minutes.
XERO_TARGET_SESSION_REQUIRED=true
XERO_TARGET_SESSION_TTL_SECONDS=1800

DEMO_ACTOR_ID=xero-demo-operator
LOG_LEVEL=info

# Standalone Compose enforces these service limits directly.
APP_MEMORY_LIMIT=768m
APP_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_CPU_LIMIT=1.0
POSTGRES_SHM_SIZE=128m
NGINX_MEMORY_LIMIT=128m
NGINX_CPU_LIMIT=0.5
